<Window x:Class="AcessoRemoto.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acesso Remoto - Host" Height="470" Width="620" MinWidth="560" MinHeight="430">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Acesso Remoto" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Este computador" Margin="0,4,0,18" Opacity="0.7"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="18" BorderThickness="1" BorderBrush="#D0D0D0" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Seu número de acesso" Opacity="0.65"/>
                <TextBlock x:Name="AccessIdText" Text="--- --- ---" FontSize="34" FontWeight="Bold" Margin="0,4,0,4"/>
                <TextBlock x:Name="ConnectionStatusText" Text="Desconectado do relay"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Servidor relay" FontWeight="SemiBold"/>
            <TextBox x:Name="RelayUrlBox" Text="ws://127.0.0.1:8080" Margin="0,6,0,0" Padding="8"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <CheckBox x:Name="UnattendedCheck" Content="Permitir acesso não supervisionado" Checked="UnattendedChanged" Unchecked="UnattendedChanged"/>
            <PasswordBox x:Name="UnattendedPasswordBox" Margin="20,8,0,0" Padding="8" IsEnabled="False"/>
            <TextBlock Margin="20,5,0,0" FontSize="12" Opacity="0.65" Text="Defina uma senha forte. Ela não será salva em texto puro."/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="ConnectButton" Content="Conectar ao servidor" Width="170" Padding="8" Click="ConnectClicked"/>
            <Button Content="Salvar configurações" Width="170" Padding="8" Margin="10,0,0,0" Click="SaveClicked"/>
        </StackPanel>

        <Border Grid.Row="5" x:Name="SessionBanner" Visibility="Collapsed" Background="#22C55E" CornerRadius="8" Padding="12" Margin="0,20,0,0" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sessão remota ativa" Foreground="White" FontWeight="Bold"/>
                <Button Content="Encerrar" Margin="18,0,0,0" Padding="10,3" Click="DisconnectSessionClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
