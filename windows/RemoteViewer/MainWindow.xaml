<Window x:Class="AcessoRemoto.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acesso Remoto - Viewer" Width="1080" Height="720" MinWidth="760" MinHeight="520"
        PreviewKeyDown="WindowKeyDown" PreviewKeyUp="WindowKeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Gateway" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="RelayUrlBox" Text="ws://127.0.0.1:8080" Padding="7"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ID" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="AccessIdBox" Padding="7" FontSize="16"/>
                    <CheckBox Grid.Column="2" x:Name="UnattendedCheck" Content="Não supervisionado" VerticalAlignment="Center" Margin="14,0,8,0" Checked="UnattendedChanged" Unchecked="UnattendedChanged"/>
                    <PasswordBox Grid.Column="3" x:Name="PasswordBox" Padding="7" IsEnabled="False"/>
                    <Button Grid.Column="4" x:Name="ConnectButton" Content="Conectar" Padding="18,7" Margin="10,0,0,0" Click="ConnectClicked"/>
                    <TextBlock Grid.Column="5" x:Name="StatusText" Text="Desconectado" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#111111" ClipToBounds="True">
            <Image x:Name="RemoteImage" Stretch="Uniform" Focusable="True"
                   MouseMove="RemoteMouseMove" MouseDown="RemoteMouseDown" MouseUp="RemoteMouseUp"/>
        </Border>
    </Grid>
</Window>
